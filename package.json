{
  "name": "harness-bootstrap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "analyze": "fallow",
    "analyze:changes": "fallow audit",
    "test": "tsx --test tests/*.test.ts",
    "verify": "pnpm run check && pnpm run lint && pnpm run analyze:changes && pnpm test",
    "start": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "fallow": "^3.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.68.0"
  }
}
